{
    "name": "postshiba/wordpress",
    "description": "WordPress plugin that sends mail through PostShiba",
    "version": "0.1.0",
    "type": "wordpress-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "PostShiba\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PostShiba\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
