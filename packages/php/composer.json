{
    "name": "postshiba/postshiba",
    "description": "PHP client for the PostShiba API",
    "version": "0.1.0",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "illuminate/support": "Laravel mailer transport named postshiba",
        "symfony/mailer": "Symfony Mailer transport"
    },
    "autoload": {
        "psr-4": {
            "PostShiba\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PostShiba\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "PostShiba\\Laravel\\PostShibaServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
