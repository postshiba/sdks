{
  "name": "@postshiba/inngest",
  "version": "0.1.0",
  "description": "PostShiba Inngest adapter",
  "license": "MIT",
  "author": "PostShiba",
  "homepage": "https://github.com/postshiba/postshiba-inngest",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/postshiba/postshiba-inngest.git"
  },
  "bugs": {
    "url": "https://github.com/postshiba/postshiba-inngest/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js",
      "default": "./dist/http.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build && npm test",
    "test": "vitest run"
  },
  "peerDependencies": {
    "inngest": "^3.0.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "inngest": "^3.48.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
